# Port the API listens on
PORT=4000

# PostgreSQL connection string. Leave empty in development to use an embedded
# database (PGlite) stored in ./data/pglite — no installation needed.
DATABASE_URL=

# Long random string used to sign admin sessions (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin password hash. Generate with:  npm run hash-password -- "your-password"
# Keep the single quotes, the hash contains $ characters.
ADMIN_PASSWORD_HASH=''

# Public URL of the website (used in emails and for CORS)
WEB_ORIGIN=http://localhost:3000

# Where new booking requests are sent
OWNER_EMAIL=

# Optional SMTP for emails. If empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="kombi.ba <rezervacije@kombi.ba>"
