# Port the API listens on
PORT=4000

# PostgreSQL connection string. Leave empty in development to use an embedded
# database (PGlite) stored in ./data/pglite — no installation needed.
DATABASE_URL=

# SSL for DATABASE_URL: off (local Postgres), require (encrypted, e.g. Supabase),
# or verify (encrypted + certificate checked against DATABASE_CA_CERT).
# For Supabase use the Session pooler URL (port 5432) and DATABASE_SSL=require.
DATABASE_SSL=off
DATABASE_CA_CERT=

# Logins use Supabase Auth: the project URL (Supabase → Project Settings → API).
SUPABASE_URL=
# Optional; defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Comma-separated emails of platform admins: they approve new owners and see every van.
PLATFORM_ADMIN_EMAILS=

# Van photos: Backblaze B2 bucket (S3-compatible). Without these, photos are kept in memory (dev only).
BACKBLAZE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKBLAZE_REGION=eu-central-003
BACKBLAZE_KEY_ID=
BACKBLAZE_APP_KEY=
BACKBLAZE_BUCKET_NAME=
# Optional: where the bucket's files are public. Default: https://<bucket>.s3.<region>.backblazeb2.com
BACKBLAZE_PUBLIC_URL=

# Public URL of the website (used in emails and for CORS)
WEB_ORIGIN=http://localhost:3000

# Gets a copy of every booking request (each van's owner gets their own)
OWNER_EMAIL=

# Optional SMTP for emails. If empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="kombi.ba <rezervacije@kombi.ba>"
