    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "vitest": "4.1.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "^0.18.1",
