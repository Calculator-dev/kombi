# Where the Node API runs (server-side only)
API_URL=http://localhost:4000

# Public address of the site, used for canonical URLs, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://kombi.ba

# Supabase Auth for the admin panel: project URL and the PUBLISHABLE key (never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Tag Manager container (GTM-XXXXXXX). Empty: no tracking scripts load.
NEXT_PUBLIC_GTM_ID=
